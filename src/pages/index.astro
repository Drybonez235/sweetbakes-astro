---
import "../styles/global.css";
import Page from "../layouts/index.astro";
import { BAKERY_MENU } from "../data/menu";
---

<Page
  title="Sweet Bakes Chicago - Always Nut Free and Allergy Friendly"
  description="Sweet Bakes Chicago is a nut-free cottage bakery in Chicago. Order custom cakes and allergy-friendly baked goods with confidence. Safe & delicious!"
>

<section class="w-full">
  <div class="w-full h-64 md:h-96 bg-gray-100">
    <img src="/halloween-hero.avif" alt="Hero - Sweet Bakes Chicago" class="object-cover w-full h-full" />
  </div>
</section>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <section class="text-center space-y-4">
    <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-brand-brown)]">Sweet Bakes Chicago</h1>
    <h2 class="text-2xl md:text-3xl font-semibold">Order your nut free treats today!</h2>
    
    <p class="text-lg/7 text-[var(--color-brand-dark-brown)] max-w-2xl mx-auto">
      Celebrate the crisp autumn air with sweet, safe treats handcrafted right here in Chicago! All of our treats are baked in our 100% nut-free facility for safe, delicious fall celebrations.
    </p>


  <section class="mt-12 text-2xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- CUPCAKES -->
      <a id="cta-halloween-cupcakes" href="pricing#cupcakes" class="block h-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-lg flex flex-col transition duration-300 transform hover:scale-[1.03] hover:shadow-2xl hover:border-orange-400 focus:outline-none focus:ring-4 focus:ring-orange-300">
        <div class="h-40 bg-gray-100">
          <img 
            src="/jack-o-lantern-cupcakes.avif" 
            alt="Pumpkin Cupcakes" 
            class="object-cover w-full h-full" 
          />
        </div>
        <div class="p-4 mt-auto">
          <h4 class="text-2xl font-bold mb-1" style="font-family: 'Creepster', cursive; color:#F97316;">
            Nut Free Cupcakes
          </h4>
          <p class="font-extrabold mt-2 text-lg text-purple-700">Starting @ ${BAKERY_MENU['cupcakes'].price} a {BAKERY_MENU['cupcakes'].unit}</p>
        </div>
      </a>

      <!-- COOKIES -->
      <a id="cta-halloween-cookies" href="decorated-cookies" class="block h-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-lg flex flex-col transition duration-300 transform hover:scale-[1.03] hover:shadow-2xl hover:border-orange-400 focus:outline-none focus:ring-4 focus:ring-orange-300">
        <div class="h-40 bg-gray-100">
          <img 
            src="/gingerbread-skeletons.avif" 
            alt="Skeleton Cookie" 
            class="object-cover w-full h-full"
          />
        </div>
        <div class="p-4 mt-auto">
          <h4 class="text-2xl font-bold mb-1" style="font-family: 'Creepster', cursive; color:#F97316;">
            Nut Free Cookies
          </h4>
          <p class="font-extrabold mt-2 text-lg text-purple-700">Starting @ ${BAKERY_MENU['cookies-traditional'].price} a {BAKERY_MENU['cookies-traditional'].unit}</p>
        </div>
      </a>

      <!-- DONUTS -->
      <a id="cta-halloween-donuts" href="donuts" class="block h-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-lg flex flex-col transition duration-300 transform hover:scale-[1.03] hover:shadow-2xl hover:border-orange-400 focus:outline-none focus:ring-4 focus:ring-orange-300">
        <div class="h-40 bg-gray-100">
          <img 
            src="/halloween-donuts.avif" 
            alt="Halloween Donuts" 
            class="object-cover w-full h-full"
          />
        </div>
        <div class="p-4 mt-auto">
          <h4 class="text-2xl font-bold mb-1" style="font-family: 'Creepster', cursive; color:#F97316;">
            Nut Free Donuts
          </h4>
          <p class="font-extrabold mt-2 text-lg text-purple-700">Starting @ ${BAKERY_MENU['donuts'].price} a {BAKERY_MENU['donuts'].unit}</p>
        </div>
      </a>

      <!-- PIES -->
      <a id="cta-halloween-pies" href="pies" class="block h-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-lg flex flex-col transition duration-300 transform hover:scale-[1.03] hover:shadow-2xl hover:border-orange-400 focus:outline-none focus:ring-4 focus:ring-orange-300">
        <div class="h-40 bg-gray-100">
          <img 
            src="/pretzel-pie.avif" 
            alt="Pretzel Pie" 
            class="object-cover w-full h-full" 
          />
        </div>
        <div class="p-4 mt-auto">
          <h4 class="text-2xl font-bold mb-1" style="font-family: 'Creepster', cursive; color:#F97316;">
            Nut Free Pies
          </h4>
          <p class="font-extrabold mt-2 text-lg text-purple-700">Starting @ ${BAKERY_MENU['pie'].price} a {BAKERY_MENU['pie'].unit}</p>
        </div>
      </a>

      <!-- CAKE -->
      <a id="cta-halloween-cake" href="flavors" class="block h-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-lg flex flex-col transition duration-300 transform hover:scale-[1.03] hover:shadow-2xl hover:border-orange-400 focus:outline-none focus:ring-4 focus:ring-orange-300">
        <div class="h-40 bg-gray-100">
          <img 
            src="/carmal-cake.avif" 
            alt="White caramel cake" 
            class="object-cover w-full h-full" 
          />
        </div>
        <div class="p-4 mt-auto">
          <h4 class="text-2xl font-bold mb-1" style="font-family: 'Creepster', cursive; color:#F97316;">
            Nut Free Cake
          </h4>
          <p class="font-extrabold mt-2 text-lg text-purple-700">Starting at ${BAKERY_MENU['cake-six-inch'].price}</p>
        </div>
      </a>

      <!-- MACARONS -->
      <a id="cta-halloween-macarons" href="macarons" class="block h-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-lg flex flex-col transition duration-300 transform hover:scale-[1.03] hover:shadow-2xl hover:border-orange-400 focus:outline-none focus:ring-4 focus:ring-orange-300">
        <div class="h-40 bg-gray-100">
          <img 
            src="/halloween-macaroons.avif" 
            alt="Halloween Macarons" 
            class="object-cover w-full h-full" 
          />
        </div>
        <div class="p-4 mt-auto">
          <h4 class="text-2xl font-bold mb-1" style="font-family: 'Creepster', cursive; color:#F97316;">
            Nut Free Macarons
          </h4>
          <p class="font-extrabold mt-2 text-lg text-purple-700">Starting @ ${BAKERY_MENU['macarons'].price} a {BAKERY_MENU['macarons'].unit}</p>
        </div>
      </a>

    </div>
  </section>
</main>

</Page>