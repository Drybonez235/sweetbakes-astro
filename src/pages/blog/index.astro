---
import BaseLayout from "../../layouts/index.astro";
import { getCollection } from "astro:content";
import "../../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog | Sweet Bakes Chicago" description="Read the latest news, recipes, and updates from Sweet Bakes Chicago.">
  <main class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-12">
      
      <!-- Hero / Header Section -->
      <section class="text-center space-y-4">
        <a href="/" class="inline-block mb-2 hover:opacity-90 transition-opacity">
          <img 
            src="/sweet-bakes-logo-nobg.avif" 
            alt="Sweet Bakes Chicago Logo" 
            class="size-32 sm:size-40 object-contain mx-auto"
            loading="eager"
          />
        </a>
        <h1 class="text-4xl/tight sm:text-5xl/tight font-bold text-[var(--color-brand-brown)]">
          Sweet Bakes Blog
        </h1>
        <p class="text-lg/7 text-[var(--color-brand-dark-brown)] max-w-2xl mx-auto backdrop-blur-xs">
          Stories, recipes, and sweet updates from our Chicago bakery.
        </p>
      </section>

      <!-- Blog Posts Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {posts.map((post) => (
          <article class="bg-[var(--color-brand-light-cream)] p-6 rounded-xl border border-[var(--color-brand-brown)]/10 shadow-xs flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-xs/4 text-[var(--color-brand-grey-green)] font-medium">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span>•</span>
                <span>{post.data.author}</span>
              </div>

              <h2 class="text-2xl/8 font-bold text-[var(--color-brand-brown)]">
                <a href={`/blog/${post.slug}/`} class="hover:text-[var(--color-brand-terracotta)] transition-colors">
                  {post.data.title}
                </a>
              </h2>

              <p class="text-base/6 text-[var(--color-brand-dark-brown)]">
                {post.data.description}
              </p>
            </div>

            {post.data.tags && (
              <div class="flex flex-wrap gap-2 pt-4 mt-4 border-t border-[var(--color-brand-brown)]/10">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/blog/tags/${tag}/`}
                    class="text-xs/4 font-semibold px-2.5 py-1 bg-[var(--color-brand-teal)]/20 text-[var(--color-brand-terracotta)] rounded-xs hover:bg-[var(--color-brand-teal)]/40 transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        ))}
      </section>

      <!-- Bottom Call to Action -->
      <section class="bg-[var(--color-brand-teal)]/20 rounded-2xl p-8 text-center space-y-4 border border-[var(--color-brand-teal)]/40">
        <h3 class="text-2xl/8 font-bold text-[var(--color-brand-brown)]">
          Looking for Something Sweet?
        </h3>
        <p class="text-base/6 text-[var(--color-brand-dark-brown)] max-w-xl mx-auto">
          Explore our complete menu of custom cakes, sunflower seed macarons, decorated cookies, and more!
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-4">
          <a 
            id="blog-CTA-flavors"
            href="/flavors/" 
            class="font-bold bg-[var(--color-brand-terracotta)] hover:bg-[var(--color-brand-dark-brown)] text-white py-3 px-6 rounded-md transition-colors"
          >
            Explore Flavors
          </a>
          <a 
            id="blog-CTA-contact"
            href="/contact/" 
            class="font-bold bg-[var(--color-brand-light-cream)] hover:bg-white text-[var(--color-brand-brown)] border border-[var(--color-brand-brown)]/30 py-3 px-6 rounded-md transition-colors"
          >
            Get in Touch
          </a>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>